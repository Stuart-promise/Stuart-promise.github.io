index 0000000000000000000000000000000000000000..f4edb3247ea14c760fc5abbd6462caea88c5ab57
--- /dev/null
+++ b/assets/scripts/model/FriendBattle.ts
@@ -0,0 +1,131 @@
+import { BattleModel } from './BattleModel';
+import type { BattleCommand, BattleEvent, BattleInit, BattleResult, BattleSession, CommandResult, UnitLocation } from './BattleTypes';
+import type { LevelConfig, Side } from './GameTypes';
+import { sameLocation } from './GridRules';
+
+export type FriendSeat = 'host' | 'guest';
+export type FormationAction = ['r'] | ['m' | 'u', number, number];
+export type PlayableBattle = Pick<BattleModel, 'snapshot' | 'dispatch' | 'step' | 'takeAiDecision'>;
+export const duelChannel = 'pet234-zhao-duel-v1';
+export interface FriendReport {
+    round: number; wave: number; winner: FriendSeat | 'draw'; hearts: number[]; kills: number[];
+}
+const reverse = (side: Side): Side => side === 'player' ? 'ai' : 'player';
+function rotate(location: UnitLocation): UnitLocation {
+    return location.kind === 'board' ? { kind: 'board', c: 7 - location.c, r: 9 - location.r } : location;
+}
+function slotOf(location: UnitLocation): number {
+    return location.kind === 'reserve' ? location.slot : 5 + (location.r - 7) * 3 + location.c - 2;
+}
+function locationOf(slot: number, side: Side): UnitLocation {
+    if (!Number.isInteger(slot) || slot < 0 || slot > 10) throw new Error('布阵格子无效');
+    if (slot < 5) return { kind: 'reserve', slot };
+    const location: UnitLocation = { kind: 'board', c: 2 + (slot - 5) % 3, r: 7 + Math.floor((slot - 5) / 3) };
+    return side === 'player' ? location : rotate(location);
+}
+function guestResult(result: BattleResult): BattleResult {
+    const swap = <T>(value: Record<Side, T>): Record<Side, T> => ({ player: value.ai, ai: value.player });
+    return { ...result, outcome: result.outcome === 'win' ? 'lose' : result.outcome === 'lose' ? 'win' : result.outcome,
+        hearts: swap(result.hearts), kills: swap(result.kills), clearTicksByWave: swap(result.clearTicksByWave) };
+}
+
+/** The simulation always runs host on the lower lane. Only the guest's view and inputs rotate. */
+export class FriendBattle implements PlayableBattle {
+    private readonly init: BattleInit;
+    private sim: BattleModel;
+    private baseline: BattleSession;
+    private actions: FormationAction[] = [];
+    locked = false;
+    round = 1;
+
+    constructor(private readonly config: LevelConfig, readonly seat: FriendSeat, id: string, seed: number,
+        private readonly submitFormation: (round: number, actions: FormationAction[]) => void) {
+        const equipment = { bow: 1, pike: 1, cavalry: 1, knife: 1 };
+        this.init = { runId: id, runSeq: 1, seed, tutorial: false, equipmentSnapshot: { player: equipment, ai: equipment } };
+        this.sim = new BattleModel(config, this.init);
+        this.baseline = this.sim.snapshot;
+    }
+    get snapshot(): BattleSession {
+        const s = this.sim.snapshot;
+        if (this.seat === 'host') return s;
+        [s.player, s.ai] = [s.ai, s.player];
+        [s.equipmentSnapshot.player, s.equipmentSnapshot.ai] = [s.equipmentSnapshot.ai, s.equipmentSnapshot.player];
+        for (const side of ['player', 'ai'] as const) for (const unit of s[side].units) {
+            unit.side = side; unit.location = rotate(unit.location);
+        }
+        for (const item of [...s.enemies, ...s.projectiles]) { item.lane = reverse(item.lane); item.x = -item.x; item.y = -item.y; }
+        if (s.result) s.result = guestResult(s.result);
+        return s;
+    }
+    private project(events: BattleEvent[]): BattleEvent[] {
+        if (this.seat === 'host') return events;
+        return events.map(e => ({ ...e, side: reverse(e.side), x: e.x === undefined ? undefined : -e.x,
+            y: e.y === undefined ? undefined : -e.y, result: e.result ? guestResult(e.result) : undefined }));
+    }
+    takeAiDecision(): null { return null; }
+    step(): BattleEvent[] {
+        const phase = this.sim.snapshot.phase;
+        if (phase === 'PREPARING' || phase === 'INTERMISSION') return [];
+        const events = this.sim.step();
+        if (events.some(e => e.type === 'PhaseChanged' && e.phase === 'INTERMISSION')) {
+            this.baseline = this.sim.snapshot;
+            this.actions = []; this.locked = false; this.round = this.baseline.waveIndex + 2;
+        }
+        return this.project(events);
+    }
+    private apply(sim: BattleModel, side: Side, op: FormationAction): CommandResult {
+        const s = sim.snapshot, header = { side, runId: s.runId, commandId: s.commandId + 1 };
+        if (!Array.isArray(op)) throw new Error('布阵指令格式错误');
+        if (op[0] === 'r' && op.length === 1) return sim.dispatch({ ...header, type: 'Recruit' });
+        if (!(op[0] === 'm' || op[0] === 'u') || op.length !== 3) throw new Error('未知布阵操作');
+        const sourceLocation = locationOf(op[1], side), targetLocation = locationOf(op[2], side);
+        const source = s[side].units.find(u => sameLocation(u.location, sourceLocation));
+        if (!source) return { ok: false, reason: 'SOURCE_CHANGED', events: [] };
+        const cmd = { ...header, sourceUnitId: source.id, sourceLocation };
+        if (op[0] === 'm') return sim.dispatch({ ...cmd, type: 'MoveUnit', targetLocation });
+        const target = s[side].units.find(u => sameLocation(u.location, targetLocation));
+        if (!target) return { ok: false, reason: 'INVALID_TARGET', events: [] };
+        return sim.dispatch({ ...cmd, type: 'MergeUnit', targetUnitId: target.id });
+    }
+    dispatch(command: BattleCommand): CommandResult {
+        const reject = (reason: string): CommandResult => ({ ok: false, reason, events: [] });
+        const s = this.snapshot;
+        if (command.runId !== s.runId || this.locked || !['PREPARING','INTERMISSION'].includes(s.phase)) return reject('INVALID_PHASE');
+        if (command.type === 'StartCountdown') {
+            if (!s.player.units.some(u => u.location.kind === 'board')) return reject('FORMATION_EMPTY');
+            this.locked = true; this.submitFormation(this.round, this.actions.slice());
+            return { ok: true, reason: '', events: [] };
+        }
+        if (this.actions.length >= 200) return reject('FORMATION_LIMIT');
+        let op: FormationAction;
+        if (command.type === 'Recruit') op = ['r'];
+        else if (command.type === 'MergeUnit' || command.type === 'MoveUnit') {
+            const source = s.player.units.find(u => u.id === command.sourceUnitId);
+            if (!source || !sameLocation(source.location, command.sourceLocation)) return reject('SOURCE_CHANGED');
+            const target = command.type === 'MergeUnit' ? s.player.units.find(u => u.id === command.targetUnitId)?.location : command.targetLocation;
+            if (!target || target.kind === 'board' && !this.config.board.playerCells.some(([c,r]) => c === target.c && r === target.r)) return reject('INVALID_TARGET');
+            op = [command.type === 'MergeUnit' ? 'u' : 'm', slotOf(source.location), slotOf(target)];
+        } else return reject('INVALID_PHASE');
+        const result = this.apply(this.sim, this.seat === 'host' ? 'player' : 'ai', op);
+        if (result.ok && result.events.length) this.actions.push(op);
+        return { ...result, events: this.project(result.events) };
+    }
+    launch(round: number, host: FormationAction[], guest: FormationAction[]): BattleEvent[] {
+        if (round !== this.round || !this.locked || !['PREPARING','INTERMISSION'].includes(this.sim.snapshot.phase)) throw new Error('布阵进度与房间不一致');
+        if (!Array.isArray(host) || !Array.isArray(guest) || host.length > 200 || guest.length > 200 ||
+            JSON.stringify(this.seat === 'host' ? host : guest) !== JSON.stringify(this.actions)) throw new Error('收到的阵容与提交记录不一致');
+        const model = new BattleModel(this.config, this.init, this.baseline);
