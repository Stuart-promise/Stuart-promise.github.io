+    report(): FriendReport | null {
+        const r = this.sim.snapshot.result;
+        if (!r) return null;
+        return { round: this.round, wave: r.wave, winner: r.outcome === 'win' ? 'host' : r.outcome === 'lose' ? 'guest' : 'draw',
